// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "nasm_devschool26",
	"build": {
		/* 
		   ВНИМАНИЮ СТУДЕНТОВ Школы разработчиков Прософт-Системы 2026-2027!
		   Для владельцев Mac на Apple Silicon (M1, M2 ...) нужно раскомментировать
		   строки со специальным dockerfile для Mac и поле "options",
		   а также закомментировать стандартный dockerfile.
		   Если ваш компьютер на базе Windows или Linux, то делать ничего не нужно.
		 */

        "dockerfile": "Dockerfile"  // Штатный Dockerfile

		/* Только для Mac!
		"dockerfile": "mac.dockerfile",
		"options": [
			"--platform",
			"linux/amd64"
		]
		//*/
    },

	/* 
		ВНИМАНИЮ СТУДЕНТОВ Школы разработчиков Прософт-Системы 2026-2027!
		Для владельцев Mac на Apple Silicon (M1, M2 ...) нужно раскомментировать
		раздел "runArgs" для принудительного запуска эмуляции х86-64.
		Если ваш компьютер на базе Windows или Linux, то делать ничего не нужно.
	 */

	/*"runArgs": [
        "--platform=linux/amd64",
        "--cap-add=SYS_PTRACE",
        "--security-opt",
        "seccomp=unconfined"
    ],*/

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "uname -a",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root"
}
