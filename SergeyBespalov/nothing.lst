     1                                  global _start       ; Директива для линкера, показывающая откуда должно начинаться выполнение программы
     2                                  section .text       ; Начало секции .text, в которой находятся машинные инструкции для процессора
     3                                  _start:             ; Метка _start - место начала выполнения программы
     4 00000000 B83C000000                  mov rax, 60     ; Копирование значения 60 в регистр rax (номер системного вызова, 60 соответствует системному вызову завершения программы)
     5 00000005 BF00000000                  mov rdi, 0      ; Копирование значения 0 в регистр rdi (аргумент системного вызова, в данном случае код возврата: 0 соответствует успешному завершению)
     6 0000000A 0F05                        syscall         ; Передача управления ядру ОС, которое выполняет инструкцию из rax с аргументом из rdi, а именно: завершение программы с кодом 0 (успех)
