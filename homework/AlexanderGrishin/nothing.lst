     1                                  global _start           ; точка входа должна быть видна компоновщику
     2                                  
     3                                  section .text           ; секция с кодом
     4                                  
     5                                  _start:
     6 00000000 B83C000000                  mov eax, 60         ; номер системного вызова exit в Linux x86-64
     7 00000005 31FF                        xor edi, edi        ; первый аргумент: код возврата 0
     8 00000007 0F05                        syscall             ; передаём управление ядру
