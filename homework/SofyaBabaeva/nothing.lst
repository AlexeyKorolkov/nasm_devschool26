     1                                  global _start           ; даём метке _start доступ извне
     2                                  
     3                                  section .text           ; секция кода
     4                                  
     5                                  _start:                 ; точка входа в программу
     6                                  
     7 00000000 B83C000000                  mov rax, 60         ; 60 - номер системного вызова exit
     8                                  
     9 00000005 BF00000000                  mov rdi, 0          ; код возврата 0 - успешное завершение процесса
    10                                  
    11 0000000A 0F05                        syscall             ; выполнение системного вызова exit
