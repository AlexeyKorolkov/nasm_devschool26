     1                                  global _start           ; даём метке _start доступ извне
     2                                  section .text           ; секция кода
     3                                  _start:                 ; точка входа в программу
     4 00000000 B83C000000                  mov rax, 60         ; 60 - номер системного вызова exit
     5 00000005 BF00000000                  mov rdi, 0          ; код возврата 0 - успешное завершение процесса
     6 0000000A 0F05                        syscall             ; выполнение системного вызова exit
