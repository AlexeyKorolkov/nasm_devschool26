     1                                  global _start           ; экспортируем метку _start чтобы её увидел компоновщик ld
     2                                  
     3                                  section .text           ; секция исполняемого кода
     4                                  
     5                                  _start:                 ; точка входа: с этого адреса ядро начинает выполнение
     6 00000000 B83C000000                  mov rax, 60         ; в rax - номер системного вызова: 60 = exit
     7 00000005 BF00000000                  mov rdi, 0          ; в rdi - первый аргумент exit: код возврата 0 (успех)
     8 0000000A 0F05                        syscall             ; передаём управление ядру - процесс завершается
